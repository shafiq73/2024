# Import Libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Load Titanic Dataset
df = sns.load_dataset('titanic')

# =========================================
# 🔹 Scatter Plots
# =========================================
df.plot(kind='scatter', x='age', y='fare', title="Age vs Fare")
plt.show()

df.plot(kind='scatter', x='age', y='fare', color='red', title="Scatter Plot (Red)")
plt.show()

df.plot(kind='scatter', x='age', y='fare', color='#FE7F0E', title="Scatter Plot (Hex Color)")
plt.show()

# =========================================
# 🔹 Bar Chart (Groupby)
# =========================================
df.groupby('sex')['fare'].mean().plot(kind='bar', title="Average Fare by Gender")
plt.ylabel('Average Fare')
plt.xlabel('Gender')
plt.show()

# =========================================
# 🔹 Seaborn Plots
# =========================================
sns.barplot(data=df, x='survived', y='fare')
plt.title("Fare vs Survival")
plt.show()

sns.scatterplot(data=df, x='age', y='fare', hue='class')
plt.title("Scatter Plot with Class")
plt.show()

# =========================================
# 🔹 Plotly Scatter
# =========================================
import plotly.express as px

fig = px.scatter(df, x='age', y='fare', color='class', title="Interactive Scatter Plot")
fig.show()

# =========================================
# 🔹 Surface Plot
# =========================================
import plotly.graph_objects as go

z_data = pd.read_csv(
    'https://raw.githubusercontent.com/plotly/datasets/master/api_docs/mt_bruno_elevation.csv'
)

fig = go.Figure(data=[go.Surface(z=z_data.values)])
fig.update_layout(title='Mt Bruno Elevation', width=500, height=500)
fig.show()

# =========================================
# 🔹 Animated Scatter (Gapminder)
# =========================================
df_gap = px.data.gapminder()

fig = px.scatter(
    df_gap,
    x="gdpPercap",
    y="lifeExp",
    animation_frame="year",
    animation_group="country",
    size="pop",
    color="continent",
    hover_name="country",
    log_x=True,
    size_max=55,
    range_x=[100, 100000],
    range_y=[25, 90]
)
fig.show()

# =========================================
# 🔹 Basic Charts (Matplotlib)
# =========================================

# Bar Chart
data = {'Products': ['A', 'B', 'C'], 'Sales': [100, 150, 80]}
df_bar = pd.DataFrame(data)

df_bar.plot(x='Products', y='Sales', kind='bar', title="Sales Bar Chart")
plt.show()

# Pie Chart
df_bar.set_index('Products')['Sales'].plot(kind='pie', autopct='%1.1f%%')
plt.title("Sales Distribution")
plt.ylabel('')
plt.show()

# Histogram
df_hist = pd.DataFrame({'Sales': np.random.randint(10, 300, 50)})
df_hist['Sales'].plot(kind='hist', bins=5, edgecolor='black', title="Histogram")
plt.show()

# Scatter Plot
df_scatter = pd.DataFrame({
    'Sales': [100, 150, 80, 120],
    'Profit': [50, 70, 40, 60]
})
df_scatter.plot(x='Sales', y='Profit', kind='scatter', title="Sales vs Profit")
plt.show()

# Line Chart
months = ['Jan','Feb','Mar','Apr','May']
sales = [100,110,120,130,140]

plt.plot(months, sales, marker='o')
plt.title("Monthly Sales Trend")
plt.show()

# Heatmap
data = np.random.rand(5,5)
sns.heatmap(data, annot=True, cmap='viridis')
plt.title("Heatmap")
plt.show()

# Boxplot
sns.boxplot(data=np.random.rand(10,3))
plt.title("Boxplot")
plt.show()

# Area Chart
plt.fill_between(months, sales, alpha=0.4)
plt.plot(months, sales)
plt.title("Area Chart")
plt.show()
